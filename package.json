{
  "name": "google-docs-clone",
  "version": "0.1.0",
  "private": true,
  "description": "Real-time collaborative document editor \u2014 Turborepo, Next.js, Yjs, Keycloak, Storybook, Atomic Design",
  "packageManager": "pnpm@11.15.1",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "services:up": "docker compose -f infra/docker-compose.yml up -d --wait",
    "services:down": "docker compose -f infra/docker-compose.yml down",
    "services:reset": "docker compose -f infra/docker-compose.yml down -v",
    "services:logs": "docker compose -f infra/docker-compose.yml logs -f",
    "db:migrate": "pnpm --filter @repo/db db:migrate",
    "db:deploy": "pnpm --filter @repo/db db:deploy",
    "db:studio": "pnpm --filter @repo/db db:studio",
    "setup": "pnpm install && pnpm env:setup && pnpm services:up && pnpm db:deploy && turbo run build --filter=@repo/db --filter=@repo/collab",
    "dev": "turbo run dev",
    "dev:web": "turbo run dev --filter=web",
    "dev:backend": "turbo run dev --filter=api --filter=collab",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "check-types": "turbo run check-types",
    "storybook": "turbo run dev --filter=storybook",
    "build-storybook": "turbo run build --filter=storybook",
    "test:e2e": "pnpm --filter web test:e2e",
    "format": "prettier --write \"**/*.{ts,tsx,mjs,json,md}\" --ignore-path .prettierignore",
    "format:check": "prettier --check \"**/*.{ts,tsx,mjs,json,md}\" --ignore-path .prettierignore",
    "clean": "turbo run clean && rm -rf node_modules",
    "env:setup": "node scripts/setup-env.mjs",
    "theme:sync": "node scripts/sync-keycloak-tokens.mjs",
    "theme:check": "node scripts/sync-keycloak-tokens.mjs --check"
  },
  "devDependencies": {
    "prettier": "^3.4.2",
    "turbo": "^2.10.7",
    "typescript": "^5.7.2"
  }
}
