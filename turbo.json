{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "tui",
  "globalDependencies": ["**/.env.*local"],
  "globalEnv": ["NODE_ENV", "ANALYZE"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**", "storybook-static/**", "dist/**"],
      "env": [
        "AUTH_KEYCLOAK_ID",
        "AUTH_KEYCLOAK_ISSUER",
        "AUTH_KEYCLOAK_SECRET",
        "AUTH_SECRET",
        "AUTH_TRUST_HOST",
        "AUTH_URL",
        "CORS_ORIGINS",
        "DATABASE_URL",
        "E2E_BASE_URL",
        "E2E_PASSWORD",
        "KEYCLOAK_ADMIN_BASE_URL",
        "KEYCLOAK_AUDIENCE",
        "KEYCLOAK_CLIENT_ID",
        "KEYCLOAK_CLIENT_SECRET",
        "KEYCLOAK_ISSUER",
        "KEYCLOAK_REALM",
        "NEXT_PUBLIC_API_URL",
        "NEXT_PUBLIC_COLLAB_URL",
        "NODE_ENV",
        "PORT"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "env": [
        "AUTH_KEYCLOAK_ID",
        "AUTH_KEYCLOAK_ISSUER",
        "AUTH_KEYCLOAK_SECRET",
        "AUTH_SECRET",
        "AUTH_TRUST_HOST",
        "AUTH_URL",
        "CORS_ORIGINS",
        "DATABASE_URL",
        "E2E_BASE_URL",
        "E2E_PASSWORD",
        "KEYCLOAK_ADMIN_BASE_URL",
        "KEYCLOAK_AUDIENCE",
        "KEYCLOAK_CLIENT_ID",
        "KEYCLOAK_CLIENT_SECRET",
        "KEYCLOAK_ISSUER",
        "KEYCLOAK_REALM",
        "NEXT_PUBLIC_API_URL",
        "NEXT_PUBLIC_COLLAB_URL",
        "NODE_ENV",
        "PORT"
      ],
      "dependsOn": ["^build"]
    },
    "lint": {
      "dependsOn": ["^lint"],
      "env": [
        "AUTH_KEYCLOAK_ID",
        "AUTH_KEYCLOAK_ISSUER",
        "AUTH_KEYCLOAK_SECRET",
        "AUTH_SECRET",
        "AUTH_TRUST_HOST",
        "AUTH_URL",
        "CORS_ORIGINS",
        "DATABASE_URL",
        "E2E_BASE_URL",
        "E2E_PASSWORD",
        "KEYCLOAK_ADMIN_BASE_URL",
        "KEYCLOAK_AUDIENCE",
        "KEYCLOAK_CLIENT_ID",
        "KEYCLOAK_CLIENT_SECRET",
        "KEYCLOAK_ISSUER",
        "KEYCLOAK_REALM",
        "NEXT_PUBLIC_API_URL",
        "NEXT_PUBLIC_COLLAB_URL",
        "NODE_ENV",
        "PORT"
      ]
    },
    "check-types": {
      "dependsOn": ["^build"]
    },
    "clean": {
      "cache": false
    }
  }
}
